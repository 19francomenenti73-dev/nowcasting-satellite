import os
import io
import requests
from PIL import Image

# Directory di output per le immagini
OUTPUT_DIR = "output"
os.makedirs(OUTPUT_DIR, exist_ok=True)

def fetch_wms_satellite(bbox, width, height, layer, filename):
    """
    Scarica direttamente dai server OGC WMS liberi (Zero Auth) 
    le mappe satellitari IR/RGB georeferenziate.
    """
    wms_base_url = "https://view.eumetsat.int/geoserver/wms"
    
    params = {
        'service': 'WMS',
        'version': '1.3.0',
        'request': 'GetMap',
        'layers': layer,
        'styles': '',
        'crs': 'EPSG:4326', # Coordinate geografiche lat/lon
        'bbox': f"{bbox[1]},{bbox[0]},{bbox[3]},{bbox[2]}", # minlat, minlon, maxlat, maxlon
        'width': str(width),
        'height': str(height),
        'format': 'image/png',
        'transparent': 'true'
    }
    
    headers = {
        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) NowcastingItalia/1.0'
    }

    try:
        print(f"Scaricamento layer {layer} per area {filename}...")
        response = requests.get(wms_base_url, params=params, headers=headers, timeout=30)
        
        if response.status_code == 200 and 'image' in response.headers.get('Content-Type', ''):
            image = Image.open(io.BytesIO(response.content))
            filepath = os.path.join(OUTPUT_DIR, filename)
            image.save(filepath, 'PNG')
            print(f"Salvato con successo: {filepath}")
        else:
            print(f"Errore nella richiesta WMS: Status {response.status_code}")
    except Exception as e:
        print(f"Eccezione durante il download: {e}")

if __name__ == "__main__":
    # --- BOUNDING BOX GEOGRAFICI ---
    EUROPE_BBOX = [-25.0, 30.0, 45.0, 70.0]  # Europa
    ITALY_BBOX = [5.0, 35.0, 20.0, 48.0]     # Italia e Mediterraneo centrale

    # --- LAYER SATELLITARI OPEN ---
    LAYER_IR = "msg_surface:seviri_colormapped_brightness_temperature_108" # Infrarosso termico 10.8um
    LAYER_CONVECTION = "msg_rgb:convection"                               # Convection RGB per temporali

    # 1. Elaborazione EUROPA
    fetch_wms_satellite(EUROPE_BBOX, 1920, 1080, LAYER_IR, "europe_ir.png")
    fetch_wms_satellite(EUROPE_BBOX, 1920, 1080, LAYER_CONVECTION, "europe_convection.png")

    # 2. Elaborazione ITALIA (Zoom alta risoluzione)
    fetch_wms_satellite(ITALY_BBOX, 1200, 1000, LAYER_IR, "italy_ir.png")
    fetch_wms_satellite(ITALY_BBOX, 1200, 1000, LAYER_CONVECTION, "italy_convection.png")
